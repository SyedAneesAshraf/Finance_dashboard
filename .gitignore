# Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Snowflake / credentials — never commit these
.env
*.env
secrets.json
snowflake_config.json
~/.snowsql/

# Power BI / Excel lock + temp files
~$*
*.tmp
.~lock.*

# Power BI Desktop local-only PBIP artifacts — machine-specific, not part of the
# portable project (this is what let a stray Desktop session pollute the repo before)
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
*.pbix

# OS
Thumbs.db
desktop.ini
.DS_Store

# Working artifacts that are regenerated, not authored
docs/_blueprint_extracted.txt
