# ---------------------------------------------------------------------------
# Snowflake connection settings — TEMPLATE ONLY.
#
# Copy this file to `.env` (same folder) and put real values THERE, not here.
# This file is committed to git, so it must never contain a real credential.
# `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Account identifier — NOT the full URL.
# Find it in the Snowsight URL: https://app.snowflake.com/<org>/<account>/
# then use  <org>-<account>   e.g.  wjbtqxs-lm31842
SNOWFLAKE_ACCOUNT=

# The username you set when activating the trial (often your email local-part,
# sometimes an all-caps name). Check Snowsight -> bottom-left profile menu.
SNOWFLAKE_USER=

# Password auth. Leave blank and set SNOWFLAKE_AUTHENTICATOR=externalbrowser
# instead if your account enforces SSO/MFA.
SNOWFLAKE_PASSWORD=

# Optional. Uncomment for SSO / MFA accounts; opens a browser to authenticate.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# These match sql/00_setup/01_create_database_and_schemas.sql — leave as-is
# unless you changed the object names there.
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FIN_PROC_WH
SNOWFLAKE_DATABASE=FIN_PROC_DB
SNOWFLAKE_SCHEMA=BRONZE
