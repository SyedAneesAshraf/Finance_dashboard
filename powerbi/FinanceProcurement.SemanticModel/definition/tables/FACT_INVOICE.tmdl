		annotation SummarizationSetBy = Automatic

	column TERM_DAYS
		dataType: double
		formatString: 0
		lineageTag: e00b0941-cd59-5226-a477-54558a2b6f7e
		summarizeBy: sum
		sourceColumn: TERM_DAYS

		annotation SummarizationSetBy = Automatic

	column 'Days Overdue' =
			IF(
			    FACT_INVOICE[STATUS] = "Unpaid",
			    DATEDIFF(FACT_INVOICE[DUE_DATE], TODAY(), DAY),
			    BLANK()
			)
		dataType: int64
		formatString: 0
		lineageTag: 24654e43-0252-5c66-90d4-5cb0ea1ab099
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Aging Sort' =
			VAR d = DATEDIFF(FACT_INVOICE[DUE_DATE], TODAY(), DAY)
			RETURN
			IF(
			    FACT_INVOICE[STATUS] <> "Unpaid",
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        d <= 0, 1,
			        d <= 30, 2,
			        d <= 60, 3,
			        d <= 90, 4,
			        5
			    )
			)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2a355c29-4530-5771-aa43-8f35e641ee85
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Aging Bucket' =
			VAR d = DATEDIFF(FACT_INVOICE[DUE_DATE], TODAY(), DAY)
			RETURN
			IF(
			    FACT_INVOICE[STATUS] <> "Unpaid",
			    BLANK(),
			    SWITCH(
			        TRUE(),
			        d <= 0, "Not Due",
			        d <= 30, "0-30 Days",
			        d <= 60, "31-60 Days",
			        d <= 90, "61-90 Days",
			        "90+ Days"
			    )
			)
		dataType: string
		lineageTag: 7b9992fd-a101-55d6-a13f-66298bb4db74
		summarizeBy: none
		sortByColumn: 'Aging Sort'

		annotation SummarizationSetBy = Automatic

