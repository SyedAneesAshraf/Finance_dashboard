		lineageTag: 255cafd5-a294-592f-b82a-96f0335307ee
		summarizeBy: none
		sourceColumn: INVOICE_DATE_KEY

		annotation SummarizationSetBy = Automatic

	column INVOICE_DATE
		dataType: dateTime
		formatString: Short Date
		lineageTag: 889a93f3-be79-5c99-9734-895acfa6ee1b
		summarizeBy: none
		sourceColumn: INVOICE_DATE

		variation Variation
			isDefault
			relationship: af556bd8-126c-420c-a81c-88c57e4596d0
			defaultHierarchy: LocalDateTable_adb24757-ff89-4bb4-9a89-6f6bf5b7e375.'Date Hierarchy'

