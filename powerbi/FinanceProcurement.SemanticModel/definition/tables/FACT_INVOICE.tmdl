/// Central AP fact. Hosts the model's measures.
table FACT_INVOICE
	lineageTag: e436ff15-1e57-5a49-92d3-cf4ec5f5d946

	/// Total invoiced value in USD across the selected context.
	measure 'Total Invoiced' = SUM(FACT_INVOICE[AMOUNT_USD])
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 19277989-db81-5eda-90ab-6a55b28ab98c

	/// Unpaid payables. The AP balance the business owes right now.
	measure 'Total Outstanding' =
			CALCULATE(
			    SUM(FACT_INVOICE[AMOUNT_USD]),
			    FACT_INVOICE[STATUS] = "Unpaid"
			)
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: d6e10141-8a3f-5f50-8edb-39c2e82eb3a9

	/// Unpaid invoices already past their due date.
	measure 'Total Overdue' =
			CALCULATE(
			    SUM(FACT_INVOICE[AMOUNT_USD]),
			    FACT_INVOICE[STATUS] = "Unpaid",
			    FACT_INVOICE[DUE_DATE] < TODAY()
			)
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 80c7fa7a-6987-5f35-b986-eac2bfe69d10

	/// DIVIDE rather than the / operator: when nothing is outstanding the denominator is zero, and / would raise an error that renders as Infinity on the card. DIVIDE returns BLANK instead.
	measure '% Overdue' =
			DIVIDE(
			    [Total Overdue],
			    [Total Outstanding]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8adb3b23-59d1-5589-9dde-a740b80756cf

	/// Average days between invoice and payment. Reads the stored DAYS_TO_PAY column so DAX and SQL cannot drift apart.
	measure 'Avg DPO' = AVERAGE(FACT_PAYMENT[DAYS_TO_PAY])
		formatString: #,0.0
		lineageTag: 16c398a9-1527-5db8-a2ee-8b83355d19f5

	measure 'Total Paid' = SUM(FACT_PAYMENT[AMOUNT_PAID_USD])
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: 7cd8288d-4820-569e-be7e-be5aac5c69c0

	measure 'Invoice Count' = COUNTROWS(FACT_INVOICE)
		formatString: #,0
		lineageTag: 1ec4694f-2918-5162-b2f0-0c24fcd4636a

	measure 'Overdue Invoice Count' =
			CALCULATE(
			    COUNTROWS(FACT_INVOICE),
			    FACT_INVOICE[STATUS] = "Unpaid",
			    FACT_INVOICE[DUE_DATE] < TODAY()
			)
		formatString: #,0
		lineageTag: 768ed512-1dea-5d54-b1af-dd0983e4661e

	/// Same period last year. Requires DIM_DATE to be marked as a date table with a contiguous date column, which is why the dimension spans 2024-2027 rather than only the fact range.
	measure 'Total Paid LY' =
			CALCULATE(
			    [Total Paid],
			    SAMEPERIODLASTYEAR(DIM_DATE[FULL_DATE])
			)
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: e5ff7b33-6648-5ebe-805c-52ed2cd6c1b3

	/// Month-over-month change in payments, via CALCULATE + DATEADD.
	measure 'Paid MoM %' =
			VAR current_month = [Total Paid]
			VAR prior_month =
			    CALCULATE(
			        [Total Paid],
			        DATEADD(DIM_DATE[FULL_DATE], -1, MONTH)
			    )
			RETURN
			    DIVIDE(current_month - prior_month, prior_month)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ec11713a-cb19-5f52-a533-c74350bd41c5

	/// Running share of total spend for the Pareto line. FILTER over ALLSELECTED sums every vendor spending at least as much as this one, which is what makes the curve cumulative without needing a stored rank column.
	measure 'Cumulative Spend %' =
			VAR this_vendor = [Total Invoiced]
			VAR all_spend =
			    CALCULATE([Total Invoiced], ALLSELECTED(DIM_VENDOR))
			VAR spend_at_or_above =
			    CALCULATE(
			        [Total Invoiced],
			        FILTER(
			            ALLSELECTED(DIM_VENDOR[VENDOR_NAME]),
			            [Total Invoiced] >= this_vendor
			        )
			    )
			RETURN
			    DIVIDE(spend_at_or_above, all_spend)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6e6b670a-4eb6-5eda-a7b5-59cacbed68d2

	/// Suspected duplicate invoice pairs flagged for AP review.
	measure 'Duplicate Invoice Pairs' = COUNTROWS(VW_DUPLICATE_INVOICE_PAIRS)
		formatString: #,0
		lineageTag: 189eedaf-b399-5067-901d-bbbe535b8dfc

	/// Value at risk if every flagged duplicate were paid twice.
	measure 'Duplicate Exposure' = SUM(VW_DUPLICATE_INVOICE_PAIRS[EXPOSURE_USD])
		formatString: $#,0.00;($#,0.00);$#,0.00
		lineageTag: dad645f1-04a0-54e5-b6f9-8b1252317348

	/// POs where cumulative invoiced value breaches the 5% tolerance.
	measure 'Match Exceptions' =
			CALCULATE(
			    COUNTROWS(VW_THREE_WAY_MATCH),
			    VW_THREE_WAY_MATCH[MATCH_STATUS] = "Exception - Review"
			)
		formatString: #,0
		lineageTag: 890447b8-2d4c-5d57-86f5-a88c8460061b

	column INVOICE_ID
