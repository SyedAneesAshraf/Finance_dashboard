		variation Variation
			isDefault
			relationship: f8a2aab9-f6a8-4200-8038-18686d41e8fe
			defaultHierarchy: LocalDateTable_54427134-ef93-4ed5-b0a2-6e831d5b0424.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column AMOUNT
